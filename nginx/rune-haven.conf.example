server {
    listen 80;
    listen [::]:80;
    server_name YOUR_ALPHA_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_ALPHA_DOMAIN;

    root /var/www/rune-haven-website;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/YOUR_ALPHA_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_ALPHA_DOMAIN/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/alpha/ {
        proxy_pass http://127.0.0.1:19253;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1d;
    }

    location / {
        try_files $uri =404;
    }
}
